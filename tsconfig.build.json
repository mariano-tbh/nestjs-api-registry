{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "exclude": [
    "**/*.spec.ts",
    "apigen/__fixtures__",
    "test",
    "node_modules",
    "vitest.config.mts",
    "core/**/*.d.ts",
    "nestjs/**/*.d.ts",
    "apigen/**/*.d.ts",
    "bin/**/*.d.ts",
    "*.d.ts"
  ]
}
