{
  "name": "nestjs-api-registry",
  "version": "0.1.0-alpha.2",
  "description": "Configurable NestJS module for registering and injecting named axios-based API clients.",
  "keywords": [
    "api-client",
    "axios",
    "dynamic-module",
    "http-client",
    "nestjs"
  ],
  "homepage": "https://github.com/mariano-tbh/nestjs-api-registry#readme",
  "bugs": {
    "url": "https://github.com/mariano-tbh/nestjs-api-registry/issues"
  },
  "license": "Apache-2.0",
  "author": "mariano-tbh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariano-tbh/nestjs-api-registry.git"
  },
  "bin": {
    "apigen": "./bin/apigen.js"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core": {
      "types": "./core/index.d.ts",
      "default": "./core/index.js"
    },
    "./nestjs": {
      "types": "./nestjs/index.d.ts",
      "default": "./nestjs/index.js"
    },
    "./apigen": {
      "types": "./apigen/index.d.ts",
      "default": "./apigen/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf -g \"core/**/*.js\" \"core/**/*.js.map\" \"core/**/*.d.ts\" \"core/**/*.d.ts.map\" \"nestjs/**/*.js\" \"nestjs/**/*.js.map\" \"nestjs/**/*.d.ts\" \"nestjs/**/*.d.ts.map\" \"apigen/**/*.js\" \"apigen/**/*.js.map\" \"apigen/**/*.d.ts\" \"apigen/**/*.d.ts.map\" \"bin/**/*.js\" \"bin/**/*.js.map\" \"bin/**/*.d.ts\" \"bin/**/*.d.ts.map\" \"index.js\" \"index.js.map\" \"index.d.ts\" \"index.d.ts.map\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "pretest": "npm run clean",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "npm run lint && npm run format:check && npm test && npm run build",
    "postpublish": "npm run clean"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "openapi-typescript": "^7.13.0",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@types/yargs": "^17.0.35",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "reflect-metadata": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
